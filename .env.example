# Copy to .env and fill in values (required for local dev, build, and preview)

VITE_SUPABASE_URL=

VITE_SUPABASE_ANON_KEY=


# Optional — override staff cockpit path (default is /spec-ops/ e.g. http://localhost:5173/spec-ops/)

# VITE_ADMIN_APP_PATH=/custom-path

# / redirects to /order. Security: Supabase Auth + RLS + strong passwords.



# Optional — kiosk at /kiosk. If unset or empty, /kiosk works without ?key= (dev only).

# If set, open /kiosk?key=YOUR_SECRET (and use the same value in "View Kiosk" in admin).

# VITE_KIOSK_SECRET=



# Optional — kitchen display at /kds

# VITE_KDS_SECRET=



# -----------------------------------------------------------------------------

# Public online ordering (/order, /track) uses the same VITE_SUPABASE_* as above.

# Order creation calls Edge Functions: POST {SUPABASE_URL}/functions/v1/online-order-create

# with Authorization: Bearer {anon key}. No extra VITE_* keys are required for MVP.

#

# Production static host: configure rewrites so /order and /track serve index.html

# (same as /kiosk and /kds).

# -----------------------------------------------------------------------------

# Optional — Google Maps on /order checkout (delivery): search + draggable pin + tap map.

# Enable "Maps JavaScript API", "Places API", "Geocoding API" in Google Cloud Console.

# Restrict the key by HTTP referrer (localhost + your domain).

# VITE_GOOGLE_MAPS_API_KEY=


# Optional — shown on /order right sidebar (address & phone). Hours come from online_settings.hours_json when set.

# VITE_ORDER_VENUE_ADDRESS=

# VITE_ORDER_VENUE_PHONE=+994...


# If /order only shows takeaway, enable delivery in Supabase: online_settings.delivery_enabled = true

# (migration 20260325140000_online_settings_delivery_on_by_default.sql) or Table Editor.


# Set to true to hide the Delivery option on /order (pickup-only marketing site).

# VITE_ORDER_HIDE_DELIVERY_UI=true

# Optional — fixed location for Home 7-day weather strip (defaults to Baku).
# Uses free Open-Meteo API and is cached client-side for one fetch per day.
# VITE_WEATHER_LAT=40.4093
# VITE_WEATHER_LON=49.8671


# -----------------------------------------------------------------------------



# --- Supabase Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets,

#     not in Vite .env — never expose service role or payment keys to the browser)

# SUPABASE_URL=              # usually injected by Supabase

# SUPABASE_SERVICE_ROLE_KEY=

# APP_BASE_URL=              # public site URL for payment return links

# EPOINT_PUBLIC_KEY=

# EPOINT_PRIVATE_KEY=

# EPOINT_WEBHOOK_SECRET=     # validate incoming webhooks (HMAC SHA-256 in epoint-webhook)

# WOLT_API_TOKEN=
# When set, online-order-create triggers wolt-drive-create after each delivery sale (API mode).

# WOLT_WEBHOOK_SECRET=

# Optional — Wolt Drive merchant portal for manual dispatch (staff "Open portal" link).
# VITE_WOLT_PORTAL_URL=https://portal.wolt.com       # simple shared secret header check in wolt-drive-webhook


