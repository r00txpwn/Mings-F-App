# Copy to .env and fill in values (required for local dev, build, and preview)

VITE_SUPABASE_URL=

VITE_SUPABASE_ANON_KEY=

# Build target is set by npm scripts / vite --mode (staff | storefront). Do not set manually unless debugging.

# VITE_BUILD_TARGET=staff


# Optional — override staff cockpit path (default is /spec-ops/ e.g. http://localhost:5173/spec-ops/)

# VITE_ADMIN_APP_PATH=/custom-path

# Root `/` is not the storefront — see PublicNotFound. Security: Supabase Auth + RLS + strong passwords.

# --- Subdomain surfaces (optional; comma-separated hostnames, exact match, lowercase) ---
# When the current hostname matches, that app loads at `/` without path prefix.
# Leave unset for path-only routing: /spec-ops (admin), /order, /kiosk, /kds, /track.

# VITE_SURFACE_ADMIN_HOSTS=app.mings.az,staff.mings.az
# VITE_SURFACE_ORDER_HOSTS=order.mings.az
# VITE_SURFACE_KIOSK_HOSTS=kiosk.mings.az
# VITE_SURFACE_KDS_HOSTS=kds.mings.az
# VITE_SURFACE_TRACK_HOSTS=track.mings.az

# Full URL to open the online menu from staff (e.g. https://order.mings.az or https://site.com/order).
# If unset, same-origin + `/order` is used (path-based deploys).

# VITE_PUBLIC_ORDER_URL=https://order.mings.az

# Full URL to open kiosk preview (optional; defaults same-origin + `/kiosk` + ?key= when secret set).

# VITE_PUBLIC_KIOSK_URL=https://kiosk.mings.az

# Optional — kiosk at /kiosk. If unset or empty, /kiosk works without ?key= (dev only).

# If set, open /kiosk?key=YOUR_SECRET (and use the same value in "View Kiosk" in admin).

# VITE_KIOSK_SECRET=



# Optional — kitchen display at /kds (staff deploy only)

# VITE_KDS_SECRET=

# Matching Edge secret for kds-order-status-update (Supabase Dashboard → Edge Functions → Secrets):

# KDS_SECRET=



# -----------------------------------------------------------------------------

# Public online ordering (/order, /track) uses the same VITE_SUPABASE_* as above.

# Order creation calls Edge Functions: POST {SUPABASE_URL}/functions/v1/online-order-create

# with Authorization: Bearer {anon key}. No extra VITE_* keys are required for MVP.
# For local payment sandbox testing, point only Edge Function calls at local Supabase:
# VITE_SUPABASE_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1

#

# Production static host: configure rewrites so /order and /track serve index.html

# (same as /kiosk and /kds).

# -----------------------------------------------------------------------------

# Optional — Google Maps on /order checkout (delivery): search + draggable pin + tap map.

# Enable "Maps JavaScript API", "Places API", "Geocoding API" in Google Cloud Console.

# Restrict the key by HTTP referrer (localhost + your domain).

# VITE_GOOGLE_MAPS_API_KEY=


# Optional — shown on /order right sidebar (address & phone). Hours come from online_settings.hours_json when set.

# VITE_ORDER_VENUE_ADDRESS=

# VITE_ORDER_VENUE_PHONE=+994...


# If /order only shows takeaway, enable delivery in Supabase: online_settings.delivery_enabled = true

# (migration 20260325140000_online_settings_delivery_on_by_default.sql) or Table Editor.


# Set to true to hide the Delivery option on /order (pickup-only marketing site).

# VITE_ORDER_HIDE_DELIVERY_UI=true

# Optional — fixed location for Home 7-day weather strip (defaults to Baku).
# Uses free Open-Meteo API and is cached client-side for one fetch per day.
# VITE_WEATHER_LAT=40.4093
# VITE_WEATHER_LON=49.8671

# -----------------------------------------------------------------------------

# Optional — local developer tooling for Linear issue workflows.
# Used by: npm run close:issue, npm run qa:handoff, npm run qa:result (also read from .env.local if not set in shell)
# LINEAR_API_KEY=
# STAFF_PASSWORD=
# Optional — base URL for Playwright `npm run verify:fix -- --issue=MIN-10` Order Manager checks (defaults to https://order.mings.az/order-manager).
# ORDER_MANAGER_VERIFY_URL=http://127.0.0.1:4175/order-manager


# -----------------------------------------------------------------------------



# --- Supabase Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets,

#     not in Vite .env — never expose service role or payment keys to the browser)

# SUPABASE_URL=              # usually injected by Supabase

# SUPABASE_SERVICE_ROLE_KEY=

# APP_BASE_URL=              # public site URL for payment return links (e.g. https://order.mings.az)

# APP_STOREFRONT_PATH=/      # optional; use when storefront lives at / on APP_BASE_URL (omit /order segment)

# United Payment (hosted card payment) - set these as Supabase Edge Function secrets.
# Exact endpoint URLs should be confirmed by United Payment; API_BASE is optional when
# every individual endpoint URL is set.
# UNITED_PAYMENT_API_BASE=
# UNITED_PAYMENT_AUTH_URL=
# UNITED_PAYMENT_CHECKOUT_URL=
# UNITED_PAYMENT_STATUS_BY_ORDER_URL=       # may include {clientOrderId}
# UNITED_PAYMENT_STATUS_BY_TRANSACTION_URL= # may include {transactionId}
# UNITED_PAYMENT_STATUS_METHOD=GET
# UNITED_PAYMENT_EMAIL=
# UNITED_PAYMENT_USERNAME=
# UNITED_PAYMENT_PASSWORD=
# UNITED_PAYMENT_MERCHANT_ID=
# UNITED_PAYMENT_USER_CODE=
# UNITED_PAYMENT_HASH_KEY=
# UNITED_PAYMENT_WEBHOOK_SECRET=
# UNITED_PAYMENT_WEBHOOK_URL=               # optional: when set, checkout JSON includes webhookUrl; omitted when unset
# UNITED_PAYMENT_FUNCTIONS_PUBLIC_URL=       # local tunnel or deployed functions URL, e.g. https://.../functions/v1
# UNITED_PAYMENT_ALLOW_UNVERIFIED_WEBHOOKS=false

# Legacy EPoint keys retained until the old integration is fully removed.
# EPOINT_PUBLIC_KEY=
# EPOINT_PRIVATE_KEY=

# Optional: override API host (default https://epoint.az/api/1)
# EPOINT_API_BASE=

# Redirect targets after hosted pay (epoint-create-payment builds URLs from APP_BASE_URL + APP_STOREFRONT_PATH).
# EPOINT_SUCCESS_URL=        # optional override of success URL
# EPOINT_ERROR_URL=

# Epoint result/callback URL in merchant dashboard → your deployed function, e.g.
# https://<project-ref>.supabase.co/functions/v1/epoint-webhook

# EPOINT_WEBHOOK_SECRET=     # optional: legacy dev webhook (plain JSON + HMAC SHA-256 header)

# PAYMENT_RECONCILE_SECRET=  # Edge `payment-reconcile`: Bearer secret for manual stuck-payment rescue (Dashboard secrets only).

# WOLT_API_TOKEN=

# WOLT_WEBHOOK_SECRET=       # simple shared secret header check in wolt-drive-webhook


