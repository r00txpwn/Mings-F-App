# Copy to .env and fill in values (required for local dev, build, and preview)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# SUBDOMAIN SPLIT
# Set to 'sp' for sp.mings.az (admin + KDS) or 'order' for order.mings.az
# (online ordering + kiosk + /management). Defaults to 'sp' if unset.
# VITE_APP_SURFACE=sp

# Optional — override staff cockpit path (default: /spec-ops)
# VITE_ADMIN_APP_PATH=/custom-path

# Optional — kiosk secret gate. If unset, /kiosk works without ?key= (dev only).
# VITE_KIOSK_SECRET=

# Optional — kitchen display secret gate
# VITE_KDS_SECRET=

# -----------------------------------------------------------------------------
# PUBLIC ONLINE ORDERING (/order, /track, /management)
# Uses same VITE_SUPABASE_* above. No extra VITE_* keys required for MVP.

# Optional — Google Maps on /order checkout (delivery): search + draggable pin.
# Enable Maps JavaScript API, Places API, Geocoding API in Google Cloud Console.
# VITE_GOOGLE_MAPS_API_KEY=

# Optional — shown on /order sidebar (address & phone)
# VITE_ORDER_VENUE_ADDRESS=
# VITE_ORDER_VENUE_PHONE=+994...

# Set to true to hide Delivery option (pickup-only mode)
# VITE_ORDER_HIDE_DELIVERY_UI=true

# Optional — weather strip location on Home screen (defaults to Baku)
# VITE_WEATHER_LAT=40.4093
# VITE_WEATHER_LON=49.8671

# -----------------------------------------------------------------------------
# SUPABASE EDGE FUNCTION SECRETS
# Set these in: Supabase Dashboard → Project Settings → Edge Functions → Secrets
# Never expose service role or payment keys to the browser.

# SUPABASE_URL=              # auto-injected by Supabase runtime
# SUPABASE_SERVICE_ROLE_KEY= # auto-injected by Supabase runtime

# --- Wolt Drive Delivery ---
# WOLT_API_TOKEN=            # Bearer token from Wolt Drive team
# WOLT_MERCHANT_ID=          # Wolt merchant ID
# WOLT_PICKUP_ADDRESS=       # Restaurant street address (e.g. "123 Nizami St, Baku")
# WOLT_PICKUP_LAT=           # Restaurant latitude
# WOLT_PICKUP_LNG=           # Restaurant longitude
# WOLT_SUPPORT_PHONE=        # Customer support phone shown to courier
# WOLT_WEBHOOK_SECRET=       # Bearer token Wolt uses to authenticate webhook calls
# WOLT_API_BASE=             # Optional override (default: https://restaurant-api.wolt.com)
#                            # Use https://sandbox-restaurant-api.wolt.com for staging
