{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode staff --open /spec-ops",
    "dev:staff": "vite --mode staff --open /spec-ops",
    "dev:storefront": "vite --mode storefront --open /order",
    "build": "npm run build:staff",
    "build:staff": "vite build --mode staff && node scripts/prepare-dist-output.mjs staff && node scripts/write-build-meta.mjs dist-staff",
    "build:storefront": "vite build --mode storefront && node scripts/prepare-dist-output.mjs storefront && node scripts/write-build-meta.mjs dist-storefront",
    "build:all": "npm run build:staff && npm run build:storefront",
    "lint": "eslint .",
    "preview": "vite preview --mode staff",
    "preview:staff": "vite preview --mode staff --outDir dist-staff",
    "preview:storefront": "vite preview --mode storefront --outDir dist-storefront",
    "deploy:local": "npm run verify-env && npm run build:staff && npm run preview:staff",
    "deploy:local:storefront": "npm run verify-env && npm run build:storefront && npm run preview:storefront",
    "prepare": "git config core.hooksPath .githooks || true",
    "routes": "node scripts/generate-route-chart.js",
    "verify-env": "node scripts/verify-env.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "qa": "node scripts/qa-orchestrator.mjs",
    "supabase:push": "node scripts/run-supabase-cli.mjs db push",
    "supabase:deploy:order": "node scripts/run-supabase-cli.mjs functions deploy online-order-create --no-verify-jwt",
    "supabase:deploy:epoint": "node scripts/run-supabase-cli.mjs functions deploy epoint-create-payment --no-verify-jwt",
    "supabase:deploy:payment-reconcile": "node scripts/run-supabase-cli.mjs functions deploy payment-reconcile --no-verify-jwt",
    "supabase:deploy:admin-api": "node scripts/run-supabase-cli.mjs functions deploy admin-api --no-verify-jwt",
    "supabase:deploy:kds-status": "node scripts/run-supabase-cli.mjs functions deploy kds-order-status-update --no-verify-jwt",
    "supabase:deploy:united-payment": "node scripts/run-supabase-cli.mjs functions deploy united-payment-create-payment --no-verify-jwt && node scripts/run-supabase-cli.mjs functions deploy united-payment-return --no-verify-jwt && node scripts/run-supabase-cli.mjs functions deploy united-payment-webhook --no-verify-jwt && node scripts/run-supabase-cli.mjs functions deploy united-payment-status-check --no-verify-jwt",
    "supabase:functions:serve": "node scripts/run-supabase-cli.mjs functions serve --env-file .env.local",
    "supabase:deploy:web": "npm run supabase:deploy:order && npm run supabase:deploy:united-payment",
    "supabase:sync": "npm run supabase:push && npm run supabase:deploy:web",
    "supabase:repair:remote": "bash scripts/supabase-repair-remote-orphans.sh",
    "supabase:repair:remote:ps": "powershell -ExecutionPolicy Bypass -File scripts/supabase-repair-remote-orphans.ps1",
    "supabase:mark:applied": "bash scripts/supabase-mark-local-applied.sh",
    "supabase:mark:applied:ps": "powershell -ExecutionPolicy Bypass -File scripts/supabase-mark-local-applied.ps1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.57.4",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.58.2",
    "@types/google.maps": "^3.58.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "localtunnel": "^2.0.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^3.2.0"
  }
}
