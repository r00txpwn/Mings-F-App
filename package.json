{
  "name": "mings-os",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-staff.mjs",
    "dev:staff": "node scripts/dev-staff.mjs",
    "dev:storefront": "node scripts/dev-storefront.mjs",
    "build": "npm run build:staff",
    "build:staff": "vite build --mode staff && node scripts/prepare-dist-output.mjs staff && node scripts/write-build-meta.mjs dist-staff",
    "build:storefront": "vite build --mode storefront && node scripts/prepare-dist-output.mjs storefront && node scripts/write-build-meta.mjs dist-storefront",
    "build:all": "npm run build:staff && npm run build:storefront",
    "lint": "eslint .",
    "preview": "vite preview --mode staff",
    "preview:staff": "vite preview --mode staff --outDir dist-staff --host 127.0.0.1 --port 4175 --strictPort",
    "preview:storefront": "vite preview --mode storefront --outDir dist-storefront --host 127.0.0.1 --port 4176 --strictPort",
    "deploy:local": "node scripts/deploy-local-staff.mjs",
    "deploy:local:lan": "node scripts/deploy-local-staff-lan.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "tunnel:ngrok": "node scripts/tunnel-ngrok.mjs",
    "deploy:local:storefront": "node scripts/deploy-local-storefront.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "routes": "node scripts/generate-route-chart.js",
    "verify-env": "node scripts/verify-env.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:expenses-crud": "node scripts/run-expenses-crud-e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "release": "node scripts/release.mjs",
    "qa": "node scripts/qa-orchestrator.mjs",
    "qa:plan": "node scripts/qa-plan-coverage.mjs",
    "supabase:push": "node scripts/run-supabase-cli.mjs db push",
    "supabase:reset:business-data": "powershell -ExecutionPolicy Bypass -File scripts/run-supabase-reset-business-data.ps1",
    "supabase:deploy:order": "node scripts/run-supabase-cli.mjs functions deploy online-order-create --no-verify-jwt --use-api",
    "supabase:deploy:epoint": "node scripts/run-supabase-cli.mjs functions deploy epoint-create-payment --no-verify-jwt --use-api",
    "supabase:deploy:payment-reconcile": "node scripts/run-supabase-cli.mjs functions deploy payment-reconcile --no-verify-jwt --use-api",
    "supabase:deploy:admin-api": "node scripts/run-supabase-cli.mjs functions deploy admin-api --no-verify-jwt --use-api",
    "supabase:deploy:agent-ops": "node scripts/run-supabase-cli.mjs functions deploy agent-ops --no-verify-jwt --use-api",
    "mcp:mings-ops": "node mcp/mings-ops/index.mjs",
    "mcp:mings-ops:selfcheck": "node mcp/mings-ops/selfcheck.mjs",
    "mcp:bundle:agent-ops": "node scripts/mcp-bundle-admin-functions.mjs agent-ops test-results/mcp-deploy-agent-ops.json",
    "supabase:deploy:kds-status": "node scripts/run-supabase-cli.mjs functions deploy kds-order-status-update --no-verify-jwt --use-api",
    "supabase:deploy:kds-item-prep": "node scripts/run-supabase-cli.mjs functions deploy kds-item-prep-toggle --no-verify-jwt --use-api",
    "supabase:deploy:pos-order": "node scripts/run-supabase-cli.mjs functions deploy pos-order-create --no-verify-jwt --use-api",
    "supabase:deploy:kiosk-order": "node scripts/run-supabase-cli.mjs functions deploy kiosk-order-create --no-verify-jwt --use-api",
    "supabase:deploy:united-payment": "node scripts/run-supabase-cli.mjs functions deploy united-payment-create-payment --no-verify-jwt --use-api && node scripts/run-supabase-cli.mjs functions deploy united-payment-return --no-verify-jwt --use-api && node scripts/run-supabase-cli.mjs functions deploy united-payment-webhook --no-verify-jwt --use-api && node scripts/run-supabase-cli.mjs functions deploy united-payment-status-check --no-verify-jwt --use-api",
    "supabase:functions:serve": "node scripts/run-supabase-cli.mjs functions serve --env-file .env.local",
    "supabase:deploy:web": "npm run supabase:deploy:order && npm run supabase:deploy:united-payment",
    "supabase:sync": "npm run supabase:push && npm run supabase:deploy:web",
    "supabase:repair:remote": "bash scripts/supabase-repair-remote-orphans.sh",
    "supabase:repair:remote:ps": "powershell -ExecutionPolicy Bypass -File scripts/supabase-repair-remote-orphans.ps1",
    "supabase:mark:applied": "bash scripts/supabase-mark-local-applied.sh",
    "supabase:mark:applied:ps": "powershell -ExecutionPolicy Bypass -File scripts/supabase-mark-local-applied.ps1",
    "supabase:mark:history-gaps:ps": "powershell -ExecutionPolicy Bypass -File scripts/supabase-mark-history-gaps-applied.ps1",
    "fix:supabase-ref": "node scripts/fix-supabase-project-ref.mjs",
    "mcp:bundle:admin-api": "node scripts/mcp-bundle-admin-functions.mjs admin-api test-results/mcp-deploy-admin-api.json",
    "staging:rls-check": "node scripts/staging-rls-check.mjs",
    "sandbox:agent-ops:secrets": "node scripts/set-sandbox-agent-ops-secrets.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.57.4",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.58.2",
    "@types/google.maps": "^3.58.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "localtunnel": "^2.0.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^3.2.0"
  }
}
