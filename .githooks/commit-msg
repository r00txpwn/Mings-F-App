#!/bin/sh
# Rejects commit subjects that `npm run release` cannot turn into a changelog
# entry. See docs/VERSIONING.md.
#
# Active only where core.hooksPath points at .githooks — set by the `prepare`
# script on npm install, or manually: git config core.hooksPath .githooks

subject=$(head -n 1 "$1")

# git generates these itself; they are never authored by hand.
case "$subject" in
  "Merge "*|"Revert "*|fixup!*|squash!*) exit 0 ;;
esac

pattern='^(feat|fix|perf|refactor|docs|test|style|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'
if printf '%s' "$subject" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<EOF

  Commit rejected: subject is not a conventional commit.

    got:      $subject
    expected: type(scope): description

  type must be one of:
    feat fix perf refactor docs test style build ci chore revert

  Only feat, fix and perf reach the CHANGELOG. Append ! for a breaking
  change, e.g. feat(api)!: drop the legacy order route

  Examples:
    feat(cockpit): add Task Master board
    fix(auth): stop network blips from blocking sign-in

  To bypass once: git commit --no-verify

EOF
exit 1
